# ============================================================
# Hikma — Variables d'environnement
# Copier ce fichier en `.env.local` puis renseigner les valeurs.
# ============================================================

# --- Supabase (auth + base de données) ---

# URL du projet : Dashboard Supabase → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Clé publique « anon » — sûre à exposer côté client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Clé « service_role » — SECRET, côté serveur uniquement (jamais préfixée
# NEXT_PUBLIC_). Requise pour le pipeline d'import des données coraniques
# (Phase 2+).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Jeton d'accès personnel Supabase — SECRET, côté serveur uniquement.
# Requis pour appliquer les migrations via `npm run db:migrate`.
SUPABASE_ACCESS_TOKEN=your_supabase_access_token

# --- Site / Auth ---

# URL publique du site (domaine de production). Utilisée pour construire les
# liens de réinitialisation de mot de passe (redirectTo). Si absente, l'URL est
# dérivée de l'hôte de la requête (dev inclus) — utile pour les redirections
# Supabase (cf. Redirect URLs du projet : ajouter <siteUrl>/reset-password).
NEXT_PUBLIC_SITE_URL=

# --- Administration ---

# E-mails autorisés à accéder à /admin (séparés par des virgules).
# Si vide ou absent, personne n'est admin — la route est désactivée par défaut.
ADMIN_EMAILS=